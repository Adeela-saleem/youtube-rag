# Is file ko copy karke `.env` naam do aur apni key daalo. `.env` ko kabhi GitHub pe mat daalo.
GEMINI_API_KEY=your_key_here

# Models ki list (pehla busy/fail ho to agla try hota hai)
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash

# Frontend ke allowed URLs (comma se alag). Deploy ke baad Vercel ka URL yahan add karo.
ALLOWED_ORIGINS=http://localhost:5173
